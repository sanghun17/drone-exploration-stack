# ============================================================================
#  drone-exploration-stack — GLOBAL per-deployment config
# ============================================================================
# This is the ONLY file you edit for a new machine. After `git clone`:
#
#   1. edit the values below
#   2. bash scripts/setup.sh                  # builds image + workspace, once
#   3. bash scripts/run_{lidar,fastlivo,epic,mavros,rviz}.sh   # one per node
#
# Sourced by: ros_entrypoint.sh, build_workspace.sh, every scripts/run_*.sh.
# The lidar-facing NIC is AUTO-DETECTED (not set here) — the container puts
# HOST_IP on it itself at startup (no sudo, no broadcast route needed).
# ----------------------------------------------------------------------------

# This PC's IP on the Mid-360 subnet (192.168.1.0/24). Must be free and match
# nothing else on that subnet. Feeds the generated MID360 config + the NIC.
HOST_IP=192.168.1.5

# The Mid-360's own IP (label on the unit / Livox Viewer).
LIDAR_IP=192.168.1.188

# PX4 flight-controller serial link for MAVROS, as <device>:<baud>.
# Prefer a stable by-id path: ls -l /dev/serial/by-id/
FCU_URL=/dev/ttyUSB0:921600

# Isolated ROS master port shared by every node (deliberately not 11311 so the
# real stack never collides with a sim roscore / /clock).
ROS_MASTER_PORT=11399

diff --git a/sdk_core/command_handler/general_command_handler.cpp b/sdk_core/command_handler/general_command_handler.cpp
index 9421634..7777e6b 100644
--- a/sdk_core/command_handler/general_command_handler.cpp
+++ b/sdk_core/command_handler/general_command_handler.cpp
@@ -332,6 +332,12 @@ void GeneralCommandHandler::HandleDetectionData(uint32_t handle, uint16_t lidar_
     return;
   }
 
+  // Mid-360S reports dev_type=35; SDK2 only routes Mid-360 (9) through its
+  // command/data handlers. Normalize so all paths treat it as a Mid-360.
+  if (detection_data->dev_type == kLivoxLidarTypeMid360s) {
+    detection_data->dev_type = kLivoxLidarTypeMid360;
+  }
+
   LOG_INFO("Handle detection data, handle:{}, dev_type:{}, sn:{}, cmd_port:{}",
       handle, detection_data->dev_type, detection_data->sn, detection_data->cmd_port);
 
diff --git a/sdk_core/device_manager.cpp b/sdk_core/device_manager.cpp
index ad6801f..0aa81b5 100644
--- a/sdk_core/device_manager.cpp
+++ b/sdk_core/device_manager.cpp
@@ -538,6 +538,13 @@ void DeviceManager::OnData(socket_t sock, void *client_data) {
     return;
   }
 
+  // Mid-360S reports dev_type=35; normalize to Mid-360 (9) before the cfg-map
+  // lookup, otherwise the detection is dropped here and never reaches the
+  // command handler (livox_ros_driver2 issue #240).
+  if (detection_data->dev_type == kLivoxLidarTypeMid360s) {
+    detection_data->dev_type = kLivoxLidarTypeMid360;
+  }
+
   if (type_lidars_cfg_map_.find(detection_data->dev_type) == type_lidars_cfg_map_.end()) {
     return;
   }
